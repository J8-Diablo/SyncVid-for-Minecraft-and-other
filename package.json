{
  "name": "syncvid-for-minecraft-and-other",
  "version": "4.1.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/SyncVid.exe --icon public/favicon.ico"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.17.1",
    "http": "^0.0.1-security",
    "i18next": "^23.x",
    "i18next-browser-languagedetector": "^6.x",
    "multer": "^1.4.3",
    "serve-static": "^1.x",
    "socket.io": "^4.1.0",
    "video.js": "^8.5.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "public/**/*",
      "locales/**/*"
    ],
    "outputPath": "dist"
  }
}
